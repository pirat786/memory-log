{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memory Log",
  "version": "0.1.0",
  "identifier": "app.memorylog.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Memory Log",
        "width": 980,
        "height": 720,
        "minWidth": 420,
        "minHeight": 520
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
